# ============================================================
# Learnify Notifications — Environment Variables
# ============================================================
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#

# ── Server ─────────────────────────────────────────────────
PORT=3000

# ── Twilio (WhatsApp + SMS share the same account) ─────────
# Find these at https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp sender number (must be a Twilio-enabled WhatsApp number)
# Format: whatsapp:+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# SMS sender number (must be a Twilio-enabled SMS number)
# Format: +1234567890
TWILIO_SMS_NUMBER=+1234567890

# ── Email (Nodemailer SMTP) ────────────────────────────────
# For Gmail: enable "Less secure apps" or use an App Password
# For custom SMTP: change host/port to your provider
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS=your_app_password_here

# Sender address shown in the "From" field
EMAIL_FROM_ADDRESS=Learnify <noreply@yourschool.edu>

# ── Supabase (Database + Storage) ─────────────────────────
# Find these at https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — used by the DB client for reads/writes
# (server-only, NEVER expose in a browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon key — used by the storage service for public file uploads
SUPABASE_ANON_KEY=your_anon_key_here

# Storage bucket name (must exist in your Supabase project)
SUPABASE_STORAGE_BUCKET=challans

# ── OpenAI (AI Assistant) ──────────────────────────────────
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Mock / Sandbox mode ────────────────────────────────────
# Set to "true" during development to log messages instead of
# actually sending them.  No API calls are made.
# Also skips real Supabase uploads and uses a mock URL.
# For AI: returns realistic hardcoded responses instead of
# calling the OpenAI API.
SANDBOX=true
MOCK_MODE=true
